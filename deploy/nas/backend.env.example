# Copy this file to backend.env (next to docker-compose.yml) and fill it in.
# backend.env is read by `env_file:` in docker-compose.yml — never commit it.

DATABASE_URL="file:/app/data/db.sqlite"
BUNDLE_PATH="/app/bundle"
PORT=3001

# Same-origin via the Cloudflare Tunnel path routing (see README.md), so
# this mostly matters as a second line of defense, not the primary guard.
CORS_ORIGIN="https://pergolando.rdsign-app.it"

# The tunnel terminates TLS; the browser always sees https://, so this stays
# true. Only set to "false" for local testing without a tunnel.
SESSION_COOKIE_SECURE=true
